{
  "name": "@local/dsh-breeze-voice",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "Local Breeze TTS 2 wrapped as a universal voice-output service for DeepSeek Harness, with a settings panel and a shared voice API that any voice-consuming plugin can opt into.",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "engine/service.mjs",
    "engine/emotion.mjs",
    "engine/loudness.mjs",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "tts",
    "breeze",
    "voice"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  }
}
